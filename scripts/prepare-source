#!/usr/bin/env bash
# Fail closed if the source license, checkout or embedding API changes.
set -euo pipefail
ROOT=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
upstream=${1:?Usage: prepare-source UPSTREAM_DIRECTORY EXPECTED_COMMIT}
commit=${2:?Expected source commit is required}
[[ $(git -C "$upstream" rev-parse HEAD) == "$commit" ]]
cmp "$ROOT/LICENSE" "$upstream/LICENSE"
test -f "$upstream/pkg/envoy/files/files_linux_amd64.go"
cp "$ROOT/tests/source-build_test.go" "$upstream/internal/analytics/independent_source_build_test.go"
mkdir -p "$upstream/build-notices" "$upstream/independent-build/embed-envoy"
cp "$ROOT/NOTICE" "$upstream/build-notices/NOTICE"
cp "$ROOT/tools/embed-envoy/main.go" "$upstream/independent-build/embed-envoy/main.go"
cp "$ROOT/tests/envoy-source_test.go" "$upstream/pkg/envoy/files/independent_source_build_test.go"
